{
  "name": "dsh-taiwind",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.15.1",
  "description": "One shared Tailwind stylesheet for DSH plugins with per-plugin configuration",
  "author": "Hairy <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hairyf/dsh-taiwind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-taiwind.git"
  },
  "bugs": "https://github.com/hairyf/dsh-taiwind/issues",
  "keywords": ["dsh", "plugin", "tailwindcss"],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["README.md", "cordis.patch.yml", "dist", "icon.svg", "locale"],
  "engines": { "node": ">=22.18.0", "dsh": ">=0.2.1-alpha.1" },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-modules"],
      "platform": "web"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "nr build",
    "release": "bumpp",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "dependencies": {
    "@tailwindcss/oxide": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-modules": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx nano-staged"
  },
  "nano-staged": { "*": "eslint --fix" }
}
